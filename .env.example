# Admin key for the /admin/keys API (create, list, disable and delete client keys). 24+ characters.
GATEWAY_ADMIN_KEY=

# Optional static client keys, comma-separated (keys made via /admin/keys need no restart)
GATEWAY_API_KEYS=change-me-long-random-key

# Docker only: login for the CLI inside the container (create with: claude setup-token).
# Leave empty for the host service, which uses your existing claude login.
CLAUDE_CODE_OAUTH_TOKEN=

# Plain HTTP; put nginx (or another TLS proxy) in front. Use 127.0.0.1:8443 if nginx runs on this host.
GATEWAY_BIND=0.0.0.0:8443
# Public URL prefix, e.g. /claude/api for https://proxyx.online/claude/api/ (routes work with and without it)
GATEWAY_BASE_PATH=
# Docker only: host port to publish (the container always listens on 8443).
GATEWAY_PORT=8443

# Empty = plain chat (no tools). Set to enable agent mode, e.g. Read,Glob,Grep,WebSearch,WebFetch
# WARNING: anyone holding an API key can make the agent use these tools on this machine.
GATEWAY_TOOLS=
# Defaults to ./workspace (holds the agent's CLAUDE.md rules). Override only if you move that file too.
#GATEWAY_WORKDIR=
GATEWAY_MAX_TURNS=20

GATEWAY_DEFAULT_MODEL=claude-opus-5-5
GATEWAY_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,claude-fable-5-1
GATEWAY_MAX_CONCURRENT=4
GATEWAY_TIMEOUT_SECS=600
RUST_LOG=claude_gateway=info
